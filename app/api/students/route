import { NextRequest, NextResponse } from "next/server";

const API_SECRET_TOKEN = "YourSuperSecretToken_ChangeMe_2026";

const SAMPLE_STUDENTS = [
{
    student_id: "s123456",
    programme: "BA-AHCC",
    year_of_entrance: 2025,
    last_login: "2026-11-22T18:30:00Z",
    registered_at: "2026-09-01T10:00:00Z",
},
{
    student_id: "s234567",
    programme: "BBA-FIN",
    year_of_entrance: 2024,
    last_login: "2026-11-21T09:15:00Z",
    registered_at: "2025-09-01T11:20:00Z",
},
{
    student_id: "s345678",
    programme: "BSc-COMP",
    year_of_entrance: 2023,
    last_login: "2026-11-20T14:45:00Z",
    registered_at: "2024-09-01T09:00:00Z",
},
];

function getBearerToken(request: NextRequest): string | null {
const authHeader = request.headers.get("authorization");
if (authHeader?.startsWith("Bearer ")) {
    return authHeader.slice(7).trim();
}
return request.nextUrl.searchParams.get("token");
}

function escapeXml(unsafe: string): string {
return unsafe
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&apos;");
}

export async function GET(request: NextRequest) {
const token = getBearerToken(request);

if (token !== API_SECRET_TOKEN) {
    return NextResponse.json(
    { error: true, message: "Unauthorized. Valid token required." },
    { status: 401 }
    );
}

const format = (request.nextUrl.searchParams.get("format") || "json").toLowerCase();

if (format === "xml") {
    let xml = `<?xml version="1.0" encoding="UTF-8"?>\n<students>\n`;
    for (const row of SAMPLE_STUDENTS) {
    xml += `  <student>\n`;
    xml += `    <student_id>${escapeXml(row.student_id)}</student_id>\n`;
    xml += `    <programme>${escapeXml(row.programme)}</programme>\n`;
    xml += `    <year_of_entrance>${row.year_of_entrance}</year_of_entrance>\n`;
    xml += `    <last_login>${escapeXml(row.last_login)}</last_login>\n`;
    xml += `    <registered_at>${escapeXml(row.registered_at)}</registered_at>\n`;
    xml += `  </student>\n`;
    }
    xml += `</students>`;

    return new NextResponse(xml, {
    status: 200,
    headers: { "Content-Type": "application/xml; charset=utf-8" },
    });
}

  // JSON (default)
return NextResponse.json({
    success: true,
    count: SAMPLE_STUDENTS.length,
    students: SAMPLE_STUDENTS,
});
}